{
  "name": "wevo-tok",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build:web": "npm --workspace apps/web run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build:api": "npm --workspace apps/api run start",
    "start:web": "npm --workspace apps/web run start",
    "start:admin": "npm --workspace apps/admin run start",
    "start:api": "npm --workspace apps/api run start",
    "doctor": "npx expo-doctor"
  },
  "overrides": {
    "react-native": "0.74.5"
  }
}
